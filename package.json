{
  "name": "effect-torch",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm run build:native:matrix && pnpm --filter @effect-torch/core run build",
    "build:native:matrix": "node scripts/build-native.mjs --matrix && pnpm --filter @effect-torch/backend-cpu --filter @effect-torch/backend-apple-native --filter @effect-torch/backend-cuda --filter @effect-torch/tokenizers run build:ts && node scripts/verify-native-packages.mjs --artifacts",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "generate:native-types": "node scripts/generate-native-declarations.mjs",
    "check:native-types": "node scripts/generate-native-declarations.mjs --check",
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint -f unix && dprint check",
    "lint-fix": "NODE_OPTIONS=--experimental-strip-types oxlint --fix && dprint fmt",
    "bench": "pnpm --filter @effect-torch/bench bench",
    "bench:compile": "pnpm --filter @effect-torch/bench bench:compile",
    "bench:inference": "pnpm --filter @effect-torch/bench bench:inference",
    "bench:mlx": "pnpm --filter @effect-torch/bench bench:mlx",
    "bench:muse-glimmer": "pnpm --filter @effect-torch/bench bench:muse-glimmer",
    "bench:muse-glimmer-concurrency": "pnpm --filter @effect-torch/bench bench:muse-glimmer-concurrency",
    "bench:muse-glimmer-sglang": "pnpm --filter @effect-torch/bench bench:muse-glimmer-sglang",
    "verify:native-packages": "node scripts/verify-native-packages.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "@oxlint/plugins": "1.80.0",
    "dprint": "^0.55.2",
    "oxlint": "1.80.0",
    "typescript": "^7.0.2"
  }
}
