# Run `runpodctl doctor` once, or set the API key in this ignored file.
# RUNPOD_API_KEY=

CUDA_DEVBOX_NAME=effect-torch-cuda
CUDA_DEVBOX_GPU_ID='NVIDIA RTX PRO 6000 Blackwell Server Edition'
CUDA_DEVBOX_TEMPLATE_ID=runpod-torch-v21
CUDA_DEVBOX_TEMPLATE_IMAGE=ghcr.io/mikearnaldi/effect-torch:cuda-devbox
CUDA_DEVBOX_TEMPLATE_NAME=effect-torch-cuda
# CUDA_DEVBOX_REGISTRY_AUTH_ID=
CUDA_DEVBOX_CLOUD_TYPE=SECURE
# CUDA_DEVBOX_DATA_CENTER_IDS=EUR-IS-2
CUDA_DEVBOX_PUBLIC_IP=0
CUDA_DEVBOX_CONTAINER_DISK_GB=40
CUDA_DEVBOX_MIN_CUDA_VERSION=12.9
CUDA_DEVBOX_WAIT_SECONDS=600
CUDA_DEVBOX_DIRECTORY=/root/effect-torch

# Community Cloud needs both of these settings for direct SSH.
# CUDA_DEVBOX_CLOUD_TYPE=COMMUNITY
# CUDA_DEVBOX_PUBLIC_IP=1

# The key and create commands generate an unencrypted repository-local key by default.
# Override its ignored local path if needed.
# CUDA_DEVBOX_MANAGED_IDENTITY_FILE=$HOME/.ssh/effect-torch-cuda-devbox

# `create` writes these state fields. They can also identify an existing pod.
# CUDA_DEVBOX_POD_ID=
# CUDA_DEVBOX_ADDRESS=root@203.0.113.10
# CUDA_DEVBOX_PORT=22
# CUDA_DEVBOX_IDENTITY_FILE=/absolute/path/to/current/private-key
# CUDA_DEVBOX_MANAGED_TEMPLATE_ID=
# CUDA_DEVBOX_TEMPLATE_IMAGE_DIGEST=
