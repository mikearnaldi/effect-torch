{
  "name": "@effect-torch/models",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./DFlash": "./src/DFlash.ts",
    "./DiffusionGemma": "./src/DiffusionGemma.ts",
    "./MuseGlimmer": "./src/MuseGlimmer.ts"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./DFlash": "./dist/DFlash.js",
      "./DiffusionGemma": "./dist/DiffusionGemma.js",
      "./MuseGlimmer": "./dist/MuseGlimmer.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect-torch/core": "workspace:^",
    "@effect-torch/serve": "workspace:^",
    "@effect-torch/tokenizers": "workspace:^",
    "effect": "4.0.0-beta.101"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^4.1.10",
    "@effect-torch/backend-apple-native": "workspace:*",
    "@effect-torch/backend-cpu": "workspace:*",
    "@effect-torch/backend-cuda": "workspace:*",
    "@effect/vitest": "4.0.0-beta.101"
  }
}
